# River3 pilot settings. Copy to deploy/.env and fill in. Never commit deploy/.env.
#
#   Generate every secret separately:   python -m river3_api.cli new-secret
#   Check the result before starting:   docker compose -f deploy/docker-compose.yml run --rm api python -m river3_api.cli check-config
#
# Everything below mirrors api/river3_api/config.py (the authoritative list). Values shown are the
# production-safe defaults; a line starting with "#" leaves the API's own default in place.
# RIVER3_DATABASE_URL and RIVER3_PRINCIPALS_FILE are set by docker-compose.yml and would be
# overridden here, so they are not listed. The inline forms RIVER3_PRINCIPALS / RIVER3_ROLES (the
# same JSON as a string) exist for tests and one-off containers; keep files, not env, for a pilot.

# ---------------------------------------------------------------- required
POSTGRES_PASSWORD=
RIVER3_ENV=production
# >= 32 chars; signs the console's stream tickets
RIVER3_SECRET_KEY=

# ---------------------------------------------------------------- behind the TLS reverse proxy
# true once the proxy terminates TLS (adds Strict-Transport-Security)
RIVER3_HSTS=true
# true ONLY if the proxy sets X-Forwarded-For; otherwise clients could spoof their address
# and dodge the failed-sign-in throttle
RIVER3_TRUSTED_PROXY=false
# failed sign-ins per client IP per window (seconds) before 429
RIVER3_AUTH_FAIL_LIMIT=20
RIVER3_AUTH_FAIL_WINDOW=300
# request body limit in bytes (default 1 MiB)
# RIVER3_MAX_BODY_BYTES=1048576

# ---------------------------------------------------------------- operator actions -> containment controller
# Operator resume/terminate requests are POSTed here, signed HMAC-SHA256 over "<ts>.<delivery>.<body>".
# Must be https:// in production. The secret is shared with river3-containd and with nothing else.
# RIVER3_ACTION_WEBHOOK=https://containment.internal/river3/actions
# RIVER3_WEBHOOK_SECRET=

# ---------------------------------------------------------------- alerts (Slack-style receiver, pager relay)
# Incidents at or above the threshold, plus early-warning tier rises, are POSTed here.
# RIVER3_ALERT_SECRET is REQUIRED in production when the webhook is set, and it must differ from
# RIVER3_WEBHOOK_SECRET: whoever can read the alert channel must not be able to forge operator actions.
# RIVER3_ALERT_WEBHOOK=https://alerts.internal/river3
# RIVER3_ALERT_SECRET=
# info | high | critical
RIVER3_ALERT_MIN_SEVERITY=high

# ---------------------------------------------------------------- canary credentials
# Lets a canary-credential service POST /api/v1/canary with an HMAC (same base string as above,
# X-River3-Delivery required, replays refused) instead of holding a bearer token. >= 32 chars.
# RIVER3_CANARY_SECRET=

# ---------------------------------------------------------------- models (advisory only)
# Qwen3-8B summaries and the optional drift question. Ollama / MLX on the docker host is reached as
# host.docker.internal (docker-compose.yml maps it to the host gateway). Production requires https://
# or loopback; plain http to the host gateway needs the explicit override, which is logged as a warning.
RIVER3_LLM_BASE_URL=http://host.docker.internal:11434/v1
RIVER3_LLM_ALLOW_PLAIN_HTTP=true
RIVER3_LLM_MODEL=qwen3:8b
# seconds per summary call
RIVER3_LLM_TIMEOUT=60

# ---------------------------------------------------------------- early warning (drift tiers)
# off (default) | laya (asks the local model above, off the request path) | jev (hosted; logs leave the network)
RIVER3_DRIFT_MODEL=off
# RIVER3_DRIFT_MODEL_TIMEOUT=8
# jev only: all three are required, and opting in is deliberate because agent logs are sent off-site
# RIVER3_JEV_URL=https://...
# RIVER3_JEV_MODEL=jev-1
# RIVER3_JEV_TOKEN=
# RIVER3_JEV_OPT_IN=false
# Thresholds: starting points for design partners to tune (see README "Early warning")
# RIVER3_DRIFT_WINDOW_MIN=10
# RIVER3_DRIFT_FAILS_RISING=10
# RIVER3_DRIFT_FAILS_HIGH=40
# RIVER3_DRIFT_NEW_RESOURCES_RISING=20
# RIVER3_DRIFT_SHARED_WRITES_RISING=1
# RIVER3_DRIFT_SHARED_WRITES_HIGH=5
# RIVER3_DRIFT_UNLOGGED_MIN_EVENTS=10
# RIVER3_DRIFT_BASELINE_MIN_EVENTS=20
# seconds between tier alerts per workload (inside it only a higher tier is alerted)
# RIVER3_DRIFT_ALERT_COOLDOWN=600

# ---------------------------------------------------------------- roles
# Optional JSON {"role": ["permission", ...]} that redefines roles for this business
# (api/roles.example.json). Uncomment here AND the matching volume in docker-compose.yml.
# RIVER3_ROLES_FILE=/run/river3/roles.json
